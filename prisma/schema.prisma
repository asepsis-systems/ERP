generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Unidad {
  id        String   @id @default(uuid())
  codigo    Int      @unique
  tipo      String   // "H 100", "X 30"
  placa     String   @unique
  marca     String   // "HYUNDAI", "SHINERAY"
  chofer    String
  estado    String   @default("Activo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rutas     Ruta[]
}

model Ruta {
  id          String   @id @default(uuid())
  numeroRuta  Int      // #741, #737, etc.
  horaSalida  String   @default("06:00")
  horaRetorno String?  @default("--:--")
  unidadCodigo Int?
  unidad      Unidad?  @relation(fields: [unidadCodigo], references: [codigo])
  chofer      String
  ayudante    String?  @default("")
  destinos    String   // JSON string con array de nombres de clientes
  fecha       String   // YYYY-MM-DD
  estado      String   @default("En Ruta")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Articulo {
  id               String              @id @default(uuid())
  codigo           String              @unique
  nombre           String
  descripcion      String?
  categoria        String              @default("Insumo")
  unidadMedida     String              @default("UND")
  stockActual      Float               @default(0)
  stockMinimo      Float               @default(5)
  precioReferencia Float?              @default(0)
  ubicacion        String?             @default("Almacén Principal")
  estado           String              @default("ACTIVO")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  movimientos      MovimientoAlmacen[]
  itemsOrden       OrdenCompraItem[]
}

model Proveedor {
  id            String        @id @default(uuid())
  ruc           String        @unique
  razonSocial   String
  contacto      String?
  telefono      String?
  email         String?
  direccion     String?
  condicionPago String?       @default("Contado")
  estado        String        @default("ACTIVO")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ordenes       OrdenCompra[]
}

model OrdenCompra {
  id            String              @id @default(uuid())
  numero        String              @unique
  fecha         DateTime            @default(now())
  fechaEntrega  DateTime?
  proveedorId   String
  proveedor     Proveedor           @relation(fields: [proveedorId], references: [id])
  estado        String              @default("PENDIENTE")
  subtotal      Float               @default(0)
  igv           Float               @default(0)
  total         Float               @default(0)
  observaciones String?
  solicitante   String?             @default("Logística")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         OrdenCompraItem[]
  movimientos   MovimientoAlmacen[]
}

model OrdenCompraItem {
  id             String      @id @default(uuid())
  ordenId        String
  orden          OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  articuloId     String
  articulo       Articulo    @relation(fields: [articuloId], references: [id])
  cantidad       Float
  precioUnitario Float
  subtotal       Float
  createdAt      DateTime    @default(now())
}

model MovimientoAlmacen {
  id            String       @id @default(uuid())
  tipo          String
  fecha         DateTime     @default(now())
  articuloId    String
  articulo      Articulo     @relation(fields: [articuloId], references: [id])
  cantidad      Float
  stockAnterior Float        @default(0)
  stockNuevo    Float        @default(0)
  motivo        String
  documentoRef  String?
  responsable   String       @default("Logística")
  ordenCompraId String?
  ordenCompra   OrdenCompra? @relation(fields: [ordenCompraId], references: [id])
  observaciones String?
  createdAt     DateTime     @default(now())
}
